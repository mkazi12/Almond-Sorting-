# Copy this file to .env and fill in real values. .env is ignored by git;
# never commit database credentials.

# PostgreSQL connection. With `docker compose up -d` these values also
# create the local database on first start.
DINOS_DB_HOST=localhost
DINOS_DB_PORT=5432
DINOS_DB_NAME=dinos
DINOS_DB_USER=dinos
DINOS_DB_PASSWORD=change-me

# Folder that holds videos, images, model weights, and exports. The
# database stores paths relative to this folder. A relative value is
# resolved against the folder containing this file.
# Windows example: DINOS_MEDIA_ROOT=D:\DINOS\media
DINOS_MEDIA_ROOT=./data/media

# Optional PostgreSQL client directory; otherwise use pg_dump/pg_restore on PATH.
# DINOS_PG_BIN=C:\Program Files\PostgreSQL\18\bin
